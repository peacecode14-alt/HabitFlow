rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each verified user can access only their own single sync document.
    match /users/{userId}/sync/state {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }

      allow read: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is map;
      allow delete: if false;
    }

    // All other documents remain closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
