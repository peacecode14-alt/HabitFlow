rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each verified user can access only their own single sync document.
    match /users/{userId}/sync/state {
      function isOwner() {
        return request.auth != null
          && request.auth.uid == userId
          && request.auth.token.email_verified == true;
      }

      allow read: if isOwner();

      // updatedAt must be the server time (serverTimestamp()), not a client-chosen value.
      allow create, update: if isOwner()
        && request.resource.data.keys().hasAll(['payload', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is map
        && request.resource.data.updatedAt == request.time;

      // Owners can delete their own cloud copy ("Delete cloud copy" in Settings).
      allow delete: if isOwner();
    }

    // All other documents remain closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
